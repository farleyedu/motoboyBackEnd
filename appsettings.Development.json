{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "GoogleOAuth": {
    "Enabled": true,
    "ClientId": "GOOGLE_CLIENT_ID_DEV",
    "ClientSecret": "GOOGLE_CLIENT_SECRET_DEV",
    "RedirectUri": "https://localhost:7137/api/auth/oauth/google/callback",
    "AllowedPostLoginRedirects": [
      "zippygomotoboy://oauth",
      "https://app.zippygo.com/auth/callback"
    ],
    "DefaultPostLoginRedirect": "zippygomotoboy://oauth",
    "StateTtlMinutes": 5,
    "Scopes": [
      "openid",
      "profile",
      "email"
    ],
    "Prompt": "select_account",
    "AccessType": "offline"
  }
}
